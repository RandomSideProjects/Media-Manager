{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Manager Maintenance",
  "version": "0.1.0",
  "identifier": "fyi.xpbliss.media-manager-maintenance",
  "build": {
    "beforeDevCommand": "node src-tauri/build-frontend.mjs",
    "beforeBuildCommand": "node src-tauri/build-frontend.mjs",
    "frontendDist": "../tauri-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Media Manager Maintenance",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../service.mjs": "app-resources/Maintenance/service.mjs",
      "../torrent-job-service.mjs": "app-resources/Maintenance/torrent-job-service.mjs",
      "../../Sources": "app-resources/Sources"
    },
    "icon": ["icons/icon.icns"]
  }
}
