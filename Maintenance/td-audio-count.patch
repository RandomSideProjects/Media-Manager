+async function countAudioStreams(localPath: string): Promise<number> {
+  const proc = new Deno.Command("ffprobe", {
+    args: ["-v", "error", "-select_streams", "a", "-show_entries", "stream=index", "-of", "csv=p=0", localPath],
+    stdout: "piped",
+    stderr: "null",
+  });
+  const { code, stdout } = await proc.output();
+  if (code !== 0) throw new Error(`ffprobe exited with code ${code}`);
+  const text = new TextDecoder().decode(stdout).trim();
+  if (!text) return 0;
+  return text.split("\n").length;
+}
